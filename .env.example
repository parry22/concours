ANTHROPIC_API_KEY=
# 1 = replay cached intake replies, never call the LLM
CONCOURS_OFFLINE=0

# Sign-in: required (default) or off (single-user local use, no accounts).
CONCOURS_AUTH=required
# Who may create an account: first (only the first account; others need an invite), invite, or open.
CONCOURS_SIGNUP=first
# The local demo owner the seed script signs up (or in) with. Local development only: never reuse in production.
CONCOURS_DEMO_EMAIL=demo@concours.local
CONCOURS_DEMO_PASSWORD=demo-TRfA8wQBZa6p

# Database: SQLite in workspace/ when unset. Production: postgresql+psycopg://user:pass@host:5432/concours
# CONCOURS_DATABASE_URL=
# Encryption key for uploads, the canonical dataset and the ID map (Fernet). Unset in dev: workspace/.data_key.
# CONCOURS_DATA_KEY=
# Improvement rounds: inline (a thread in the API, local) or external (python -m app.worker, production)
CONCOURS_WORKER=inline
