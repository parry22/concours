# Generated by Brief from the hello-world template of macrocosm-os/apex-competitions-builder.
# Validate with: apex-dev preflight --spec ./spec.yaml --input fixtures/input.json --env stage
schema: apex.competition.v1
id: {{ competition_id }}
version: {{ version }}
display_name: "{{ display_name }}"
kind: solo
process_type: cpu

resources:
  cpu_limit: {{ cpu_limit }}
  mem_limit: {{ mem_limit }}
  gpu_count: 0

# PLAYER image (the solver submission server). Built and pushed by .github/workflows/release.yml.
# Digests below are the LOCAL image ids from Brief's build; the release workflow replaces them
# with the pushed GHCR digests on the first tagged release.
image:
  ref: {{ image_ref }}
  digest: {{ player_digest }}

submission:
  artifact_type: code
  max_size_mb: 5
  target_path: /app/submission.py

screening:
  max_size_mb: 5
  extra_forbidden_modules: [socket, subprocess, requests, urllib, http]

input_schema:
  $ref: ./input.schema.json

defaults:
  baseline_score: 0.0
  baseline_raw_score: 0.0
  round_length_in_days: 2
  submission_reveal_days: {{ reveal_days }}
  lower_is_better: false

entrypoints:
  evaluate:
    command: ["python", "/app/launch.py", "--port", "8000"]
    network_disabled: false
    allow_internet: false
    timeout_s: {{ evaluate_timeout_s }}
    http_api:
      port: 8000
      readiness_path: /health
      protocol: gym_v1

# REFEREE: holds the hidden leaderboard slice and private holdout, drives the player, writes /data/result.json.
referee:
  protocol: gym_v1
  image:
    ref: {{ referee_ref }}
    digest: {{ referee_digest }}
  timeout_s: {{ referee_timeout_s }}

signature:
  cosign_identity: {{ cosign_identity }}
  cosign_issuer: https://token.actions.githubusercontent.com
