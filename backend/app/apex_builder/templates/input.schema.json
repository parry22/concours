{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concours tabular competition round input",
  "type": "object",
  "required": ["tasks", "primary_metric", "metric_params"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_name", "split"],
        "properties": {
          "task_name": {"type": "string"},
          "split": {"type": "string", "enum": ["leaderboard", "holdout"]}
        },
        "additionalProperties": false
      }
    },
    "primary_metric": {"type": "string", "enum": ["recall_at_fpr", "recall_at_top_k", "wape"]},
    "metric_params": {"type": "object"},
    "secondary_metric": {"type": ["string", "null"]},
    "max_train_rows": {"type": "integer", "minimum": 0},
    "reset_timeout_s": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
