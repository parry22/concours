# Copy to deploy/.env and fill in. Never commit the filled-in file.

# The public address (DNS A record pointing at this VM) and the email Let's Encrypt writes to.
CONCOURS_DOMAIN=fraud.example.com
ACME_EMAIL=ops@example.com

# Where everything lives on the VM: database, workspace, caches, certificates. Back it up (deploy/backup.sh).
CONCOURS_DATA_ROOT=/srv/concours

# openssl rand -base64 32
POSTGRES_PASSWORD=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes uploaded files unreadable. Keep a copy outside the VM.
CONCOURS_DATA_KEY=

# The group id of /var/run/docker.sock on the VM: stat -c %g /var/run/docker.sock
DOCKER_GID=999

# first: only the very first account may sign up, everyone else needs an invite. invite: invites only.
CONCOURS_SIGNUP=first
CONCOURS_AUTH=required
CONCOURS_ENABLED_TEMPLATES=fraud

# Optional: the intake assistant for the generic templates (fraud needs none).
ANTHROPIC_API_KEY=
